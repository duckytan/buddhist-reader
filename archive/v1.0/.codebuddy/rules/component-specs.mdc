## AudioPlayer Component

### File Location
[src/components/AudioPlayer.vue](mdc:src/components/AudioPlayer.vue)

### Purpose
TTS playback controls with play/pause/stop and sentence highlighting.

### Props

```javascript
{
  text: {
    type: String,
    required: true
  },
  speed: {
    type: Number,
    default: 0.8,
    validator: (value) => value >= 0.5 && value <= 2.0
  },
  pitch: {
    type: Number,
    default: 1.0,
    validator: (value) => value >= 0.5 && value <= 2.0
  }
}
```

### Events

```javascript
// Emits when playing state changes
@play
@pause
@stop
// Emits when current sentence changes
@sentence-change
```

### State

```javascript
import { ttsEngine } from '@/utils/tts.js'

const isPlaying = ref(false)
const isPaused = ref(false)
const currentSentence = ref(0)

// Listen to TTS events
ttsEngine.onSentenceChange = (index) => {
  currentSentence.value = index
  emit('sentence-change', index)
}

// Update status
function updateStatus() {
  const status = ttsEngine.getStatus()
  isPlaying.value = status.isPlaying
  isPaused.value = status.isPaused
}
```

### Methods

```javascript
function play() {
  ttsEngine.speak(props.text, {
    rate: props.speed,
    pitch: props.pitch
  })
  emit('play')
  updateStatus()
}

function pause() {
  ttsEngine.pause()
  emit('pause')
  updateStatus()
}

function resume() {
  ttsEngine.resume()
  updateStatus()
}

function stop() {
  ttsEngine.stop()
  emit('stop')
  currentSentence.value = 0
  updateStatus()
}
```

### Template

```vue
<template>
  <div class="audio-player">
    <!-- Progress indicator -->
    <div class="player-progress">
      <span class="sentence-indicator">
        {{ currentSentence }}/{{ totalSentences }}
      </span>
    </div>
    
    <!-- Controls -->
    <div class="player-controls">
      <van-button
        :icon="isPaused ? 'play-o' : 'pause-o'"
        @click="isPaused ? resume() : pause()"
        :disabled="!isPlaying"
      >
        {{ isPaused ? '继续' : '暂停' }}
      </van-button>
      
      <van-button
        icon="play-circle-o"
        @click="play"
        :disabled="isPlaying && !isPaused"
      >
        播放
      </van-button>
      
      <van-button
        icon="cross"
        @click="stop"
        :disabled="!isPlaying"
      >
        停止
      </van-button>
    </div>
  </div>
</template>
```

### Styling

```scss
.audio-player {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  
  .player-progress {
    text-align: center;
    
    .sentence-indicator {
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
    }
  }
  
