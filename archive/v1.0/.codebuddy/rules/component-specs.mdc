## Component Integration Example

### Reader Page

```vue
<script setup>
import { ref, onMounted } from 'vue'
import ReaderContent from '@/components/ReaderContent.vue'
import AudioPlayer from '@/components/AudioPlayer.vue'
import DictionaryPopup from '@/components/DictionaryPopup.vue'
import { loadProgress, saveProgress } from '@/utils/storage.js'

const content = ref('')
const selectedTerm = ref(null)
const showDictPopup = ref(false)

onMounted(async () => {
  // Load scripture content
  content.value = await loadScripture()
})

function handleTermClick(term, position) {
  selectedTerm.value = term
  showDictPopup.value = true
}
</script>

<template>
  <div class="reader-page">
    <ReaderContent
      :content="content"
      @term-click="handleTermClick"
    />
    
    <AudioPlayer :text="content" />
    
    <DictionaryPopup
      v-if="showDictPopup"
      :visible="showDictPopup"
      :term-data="selectedTerm"
      @close="showDictPopup = false"
    />
  </div>
</template>
```

