## ReaderContent Component

### File Location
[src/components/ReaderContent.vue](mdc:src/components/ReaderContent.vue)

### Purpose
Display scripture content with dictionary highlighting and pinyin annotations.

### Props

```javascript
{
  content: {
    type: String,
    required: true
  },
  showPinyin: {
    type: Boolean,
    default: true
  },
  highlightMatches: {
    type: Boolean,
    default: true
  },
  currentSentence: {
    type: Number,
    default: -1
  }
}
```

### State

```javascript
const highlightedContent = ref('')
const trie = ref(null)
const matches = ref([])
```

### Methods

```javascript
// Initialize trie with dictionary
async function initTrie() {
  const dictionary = await import('@/data/dictionary.js')
  trie.value = buildTrie(dictionary.default)
}

// Find and highlight dictionary matches
function highlightDictionary(text) {
  if (!highlightMatches.value || !trie.value) return text
  
  const matches = findMatches(trie.value, text)
  const nonOverlapping = removeOverlaps(matches)
  
  return renderHighlights(text, nonOverlapping)
}

// Render highlighted text
function renderHighlights(text, matches) {
  if (matches.length === 0) return text
  
  let result = ''
  let lastIndex = 0
  
  matches.forEach(match => {
    // Add text before match
    result += text.substring(lastIndex, match.start)
    
    // Add highlighted term
    result += `<span class="dict-term" data-term="${match.data.term}">${text.substring(match.start, match.end)}</span>`
    
    lastIndex = match.end
  })
  
  // Add remaining text
  result += text.substring(lastIndex)
  
  return result
}
```

### Events

```javascript
// Emits when dictionary term is clicked
@term-click
// Emits when sentence changes
@sentence-change
```

### Styling

