```

### Usage Example

```javascript
import { pronunciationMap } from '@/data/pronunciation-map.js'
import { addPinyinAnnotation } from '@/utils/pronunciation.js'

// Get pronunciation for a term
const term = '般若'
const pinyin = pronunciationMap[term]
console.log(pinyin) // 'bō rě'

// Add pinyin to scripture text
const text = "观自在菩萨，行深般若波罗蜜多时"
const annotated = addPinyinAnnotation(text)
```

