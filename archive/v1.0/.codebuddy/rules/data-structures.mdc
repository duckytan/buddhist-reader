## Reading Progress Data Structure

### localStorage Key: `readingProgress`

```javascript
{
  // Progress per sutra
  'xin-jing': {
    sutraId: 'xin-jing',
    currentChapter: 'full-text',
    scrollPosition: 0.5,        // Scroll percentage (0-1)
    lastReadAt: '2026-04-25T23:51:00Z',
    completed: false
  },
  
  'jin-gang-jing': {
    sutraId: 'jin-gang-jing',
    currentChapter: 'chapter-1',
    scrollPosition: 0.25,
    lastReadAt: '2026-04-24T10:30:00Z',
    completed: false
  }
}
```

### Usage Example

```javascript
import { saveProgress, loadProgress, getProgress } from '@/utils/storage.js'

// Save progress
saveProgress('xin-jing', {
  scrollPosition: 0.5,
  currentChapter: 'full-text'
})

// Load progress
const progress = loadProgress('xin-jing')

// Get completion percentage
const completion = progress.scrollPosition * 100
```

