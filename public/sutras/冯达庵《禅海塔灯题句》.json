        {
          "id": "p1",
          "text": "禅海塔灯题句"
        },
        {
          "id": "p2",
          "text": "冯达庵"
        },
        {
          "id": "p3",
          "text": "破 参"
        },
        {
          "id": "p4",
          "text": "真骨金刚体可夸"
        },
        {
          "id": "p5",
          "text": "六尘一拂永无遮"
        },
        {
          "id": "p6",
          "text": "众生逐妄不知有"
        },
        {
          "id": "p7",
          "text": "返照心源速到家"
        },
        {
          "id": "p8",
          "text": "翻 身"
        },
        {
          "id": "p9",
          "text": "撑天拄地出潜龙"
        },
        {
          "id": "p10",
          "text": "物物头头绕万重"
        },
        {
          "id": "p11",
          "text": "问我平生亲切句"
        },
        {
          "id": "p12",
          "text": "象王行处绝狐踪"
        },
        {
          "id": "p13",
          "text": "机 用"
        },
        {
          "id": "p14",
          "text": "何需背后翻公案"
        },
        {
          "id": "p15",
          "text": "只贵当机直面提"
        },
        {
          "id": "p16",
          "text": "一觑便行停不得"
        },
        {
          "id": "p17",
          "text": "发聋震瞶若雄猊"
        },
        {
          "id": "p18",
          "text": "毕 竟"
        },
        {
          "id": "p19",
          "text": "是非情尽圣凡除"
        },
        {
          "id": "p20",
          "text": "拈尾为头总不拘"
        },
        {
          "id": "p21",
          "text": "万法升沉唯了了"
        },
        {
          "id": "p22",
          "text": "了名毕竟亦虚无"
        }
      ]
    }
  ],
