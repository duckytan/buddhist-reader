{
  "title": "唐普式七觉支颂",
  "author": "冯达庵",
  "category": "general",
  "chapters": [
    {
      "title": "全文",
      "paragraphs": [
        {
          "id": "p1",
          "text": "七觉支颂"
        },
        {
          "id": "p2",
          "text": "唐普式"
        },
        {
          "id": "p3",
          "text": "密教胎藏界莲花部准提菩萨法，将菩萨心析为七分，名七觉支菩提分。此属正等正觉，若彻底说明，非佛不可。然约浅义，则不无可说之道，因分别颂支："
        },
        {
          "id": "p4",
          "text": "择法"
        },
        {
          "id": "p5",
          "text": "返照心源，都摄六根，"
        },
        {
          "id": "p6",
          "text": "随机择法，去妄显真。"
        },
        {
          "id": "p7",
          "text": "定"
        },
        {
          "id": "p8",
          "text": "真骨为干，持之以常，"
        },
        {
          "id": "p9",
          "text": "迥脱根尘，定力坚强。"
        },
        {
          "id": "p10",
          "text": "精进"
        },
        {
          "id": "p11",
          "text": "柱地撑天，奋迅无边，"
        },
        {
          "id": "p12",
          "text": "超峰钻海，充遍大千。"
        },
        {
          "id": "p13",
          "text": "舍"
        },
        {
          "id": "p14",
          "text": "意识不断，符号重重，"
        },
        {
          "id": "p15",
          "text": "象王行处，影相全空。 喜"
        },
        {
          "id": "p16",
          "text": "法性川流，加护不息，"
        },
        {
          "id": "p17",
          "text": "定慧互应，喜受无极。"
        },
        {
          "id": "p18",
          "text": "轻安"
        },
        {
          "id": "p19",
          "text": "上向法土，下泯欲界，"
        },
        {
          "id": "p20",
          "text": "背尘合觉，轻安舒泰。"
        },
        {
          "id": "p21",
          "text": "念"
        },
        {
          "id": "p22",
          "text": "定慧双照，惺惺寂寂，"
        },
        {
          "id": "p23",
          "text": "万法升沉，明明历历。"
        }
      ]
    }
  ],
