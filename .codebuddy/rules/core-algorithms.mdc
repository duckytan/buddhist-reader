## Pronunciation Annotation

### File Location
[src/utils/pronunciation.js](mdc:src/utils/pronunciation.js)

### Purpose
Add Buddhist-specific pinyin annotations to scripture text using semantic HTML `<ruby>` tags.

### pronunciationMap
```javascript
export const pronunciationMap = {
  // Common Buddhist terms
  '般若': 'bō rě',
  '菩萨': 'pú sà',
  '菩提': 'pú tí',
  '涅槃': 'niè pán',
  '南无': 'nā mó',
  '阿弥陀佛': 'ē mí tuó fó',
  '舍利弗': 'shè lì fú',
  '须菩提': 'xū pú tí',
  '曼殊室利': 'màn shū shì lì',
  
  // Context-specific pronunciations
  '佛': {
    '佛陀': 'fó',
    default: 'fó'
  },
  // ... more mappings
}
```

### addPinyinAnnotation Function

```javascript
/**
 * Add pinyin annotation to text using Ruby tags
 * @param {String} text - Scripture text
 * @param {Boolean} showPinyin - Whether to show pinyin
 * @returns {String} HTML with ruby annotations
 */
export function addPinyinAnnotation(text, showPinyin = true) {
  if (!showPinyin) return text
  
  // Sort terms by length (longest first)
  const terms = Object.keys(pronunciationMap)
    .sort((a, b) => b.length - a.length)
  
  let result = text
  let offset = 0
  
  for (const term of terms) {
    let index = result.indexOf(term, offset)
    while (index !== -1) {
      const pinyin = typeof pronunciationMap[term] === 'string' 
        ? pronunciationMap[term]
        : pronunciationMap[term].default
      
      const annotated = `<ruby>${term}<rt>${pinyin}</rt></ruby>`
      result = result.substring(0, index) + annotated + result.substring(index + term.length)
      
      offset = index + annotated.length
      index = result.indexOf(term, offset)
    }
  }
  
  return result
}
```

### CSS for Ruby Tags
```scss
ruby {
  rt {
    font-size: 0.6em;
    color: var(--text-secondary);
    font-weight: normal;
  }
  
  // Hide pinyin via CSS if needed
  &.hide-pinyin rt {
    display: none;
  }
}
```

### Usage Example
```javascript
import { addPinyinAnnotation } from '@/utils/pronunciation.js'

const text = "观自在菩萨，行深般若波罗蜜多时"
const annotated = addPinyinAnnotation(text)
console.log(annotated)
// Output: <ruby>观<rt>guān</rt></ruby>...
```

