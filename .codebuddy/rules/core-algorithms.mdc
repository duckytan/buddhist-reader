## TTS Engine (Text-to-Speech)

### File Location
[src/utils/tts.js](mdc:src/utils/tts.js)

### Purpose
Wrapper around Web Speech API for Buddhist scripture reading with sentence-by-sentence highlighting.

### TTSEngine Class

```javascript
/**
 * TTS Engine using Web Speech API
 */
class TTSEngine {
  constructor() {
    this.synth = window.speechSynthesis
    this.utterance = null
    this.isPlaying = false
    this.isPaused = false
    this.currentSentenceIndex = 0
    this.sentences = []
    this.onSentenceChange = null
    this.onEnd = null
  }

  /**
   * Speak text with sentence-by-sentence highlighting
   * @param {String} text - Text to speak
   * @param {Object} options - { rate, pitch, voice }
   */
  speak(text, options = {}) {
    // Stop any current speech
    this.stop()
    
    // Split text into sentences
    this.sentences = this._splitSentences(text)
    this.currentSentenceIndex = 0
    
    // Create utterance
    this.utterance = new SpeechSynthesisUtterance(text)
    this.utterance.rate = options.rate || 1.0
    this.utterance.pitch = options.pitch || 1.0
    this.utterance.lang = 'zh-CN'
    
    // Event handlers
    this.utterance.onstart = () => {
      this.isPlaying = true
      this.isPaused = false
    }
    
    this.utterance.onend = () => {
      this.isPlaying = false
      if (this.onEnd) this.onEnd()
    }
    
    this.utterance.onboundary = (event) => {
      if (event.name === 'sentence') {
        this.currentSentenceIndex++
        if (this.onSentenceChange) {
          this.onSentenceChange(this.currentSentenceIndex)
        }
      }
    }
    
    // Speak
    this.synth.speak(this.utterance)
  }

  pause() {
    if (this.isPlaying && !this.isPaused) {
      this.synth.pause()
      this.isPaused = true
    }
  }

  resume() {
    if (this.isPlaying && this.isPaused) {
      this.synth.resume()
      this.isPaused = false
    }
  }

  stop() {
    this.synth.cancel()
    this.isPlaying = false
    this.isPaused = false
    this.currentSentenceIndex = 0
  }

  getStatus() {
    return {
      isPlaying: this.isPlaying,
      isPaused: this.isPaused,
      currentSentence: this.currentSentenceIndex
    }
  }

  _splitSentences(text) {
    // Split by punctuation marks
    return text.split(/([。？！；\n])/).filter(s => s.trim())
  }
}

// Singleton instance
export const ttsEngine = new TTSEngine()
```

### Browser Compatibility
- Chrome/Edge: Full support
- Firefox: Full support
- Safari: Requires user interaction to initialize
- Mobile: Check `window.speechSynthesis` availability

### Usage Example
```javascript
import { ttsEngine } from '@/utils/tts.js'

// Speak scripture
ttsEngine.speak("观自在菩萨，行深般若波罗蜜多时", {
  rate: 0.8,  // Slower for scripture
  pitch: 1.0
})

// Listen to sentence changes
ttsEngine.onSentenceChange = (index) => {
  console.log('Current sentence:', index)
  // Highlight current sentence in UI
}

// Controls
ttsEngine.pause()
ttsEngine.resume()
ttsEngine.stop()
```

