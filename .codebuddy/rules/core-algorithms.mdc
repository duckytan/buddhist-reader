# Core Algorithms Guide

## Trie Tree Dictionary Matching

### File Location
[src/utils/trie.js](mdc:src/utils/trie.js)

### Purpose
Efficiently match Buddhist terms from dictionary while reading scripture. Uses longest-match strategy to prioritize longer terms (e.g., "般若波罗蜜多" before "般若").

### Key Functions

#### `buildTrie(dictionary)`
Build a trie tree from dictionary array.
```javascript
/**
 * Build a trie tree from dictionary data
 * @param {Array} dictionary - Array of {term, ...} objects
 * @returns {Object} Trie tree root node
 */
export function buildTrie(dictionary) {
  const root = {}
  for (const entry of dictionary) {
    let node = root
    for (const char of entry.term) {
      if (!node[char]) {
        node[char] = {}
      }
      node = node[char]
    }
    node.isEnd = true
    node.data = entry
  }
  return root
}
```

#### `findMatches(trie, text)`
Find all matching terms in text.
```javascript
/**
 * Find all dictionary matches in text
 * @param {Object} trie - Trie tree root
 * @param {String} text - Text to search
 * @returns {Array} Array of {start, end, data} matches
 */
export function findMatches(trie, text) {
  const matches = []
  for (let i = 0; i < text.length; i++) {
    let node = trie
    let j = i
    while (j < text.length && node[text[j]]) {
      node = node[text[j]]
      if (node.isEnd) {
        matches.push({
          start: i,
          end: j + 1,
          data: node.data
        })
      }
      j++
    }
  }
  return matches
}
```

#### `removeOverlaps(matches)`
Remove overlapping matches, keep longest.
```javascript
/**
 * Remove overlapping matches, prioritize longest
 * @param {Array} matches - Array of match objects
 * @returns {Array} Non-overlapping matches
 */
export function removeOverlaps(matches) {
  if (matches.length === 0) return []
  
  // Sort by start position, then by length (longest first)
  matches.sort((a, b) => {
    if (a.start !== b.start) return a.start - b.start
    return (b.end - b.start) - (a.end - a.start)
  })
  
  const result = []
  let current = matches[0]
  
  for (let i = 1; i < matches.length; i++) {
    const next = matches[i]
    if (next.start >= current.end) {
      result.push(current)
      current = next
    }
    // Overlapping: skip (current is longer)
  }
  result.push(current)
  
  return result
}
```

### Performance Optimization
- Build trie in Web Worker to avoid blocking main thread
- Cache built trie in IndexedDB for faster startup
- Time complexity: O(n) where n = text length

### Usage Example
```javascript
import { buildTrie, findMatches, removeOverlaps } from '@/utils/trie.js'

// Build trie on app initialization
const dictionary = await import('@/data/dictionary.js')
const trie = buildTrie(dictionary.default)

// Find matches in scripture text
const text = "观自在菩萨，行深般若波罗蜜多时"
const rawMatches = findMatches(trie, text)
const matches = removeOverlaps(rawMatches)

// Render highlights
matches.forEach(match => {
  const term = text.substring(match.start, match.end)
  console.log(`Found: ${term}`, match.data)
})
```

