  const trie = buildTrie(dictionary)
  
  // Find matches and highlight
  const matches = findMatches(trie, scriptureText.value)
  const nonOverlapping = removeOverlaps(matches)
  
  // Render highlighted text
  highlightedText.value = renderHighlights(scriptureText.value, nonOverlapping)
  
  // Add pinyin annotations
  annotatedText.value = addPinyinAnnotation(scriptureText.value)
})

function speak() {
  ttsEngine.speak(scriptureText.value, { rate: 0.8 })
}
</script>

<template>
  <div class="reader">
